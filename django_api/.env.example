# Environment Variables Template
# Copie este arquivo para .env e preencha com seus valores

# Django Settings
SECRET_KEY=sua-chave-secreta-aqui
DEBUG=False
ALLOWED_HOSTS=seu-dominio.com,www.seu-dominio.com

# Database (PostgreSQL - opcional)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=user_api
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_HOST=seu-host-postgres
DB_PORT=5432

# CORS Settings
CORS_ALLOWED_ORIGINS=https://seu-frontend.com,https://www.seu-frontend.com

# AWS Settings (opcional)
AWS_ACCESS_KEY_ID=sua-chave-acesso-aws
AWS_SECRET_ACCESS_KEY=sua-chave-secreta-aws
AWS_STORAGE_BUCKET_NAME=seu-bucket-s3
AWS_S3_REGION_NAME=us-east-1

# Email Settings (opcional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-app
